# Copied to .env by init.sh. Placeholders only; no real keys are needed.
OPENAI_API_KEY=unused
LANGCHAIN_API_KEY=unused
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=local
# claude-cli (default) or manual
LLM_BACKEND=claude-cli
LLM_HELPER_URL=http://claude-relay:8765/complete
# init.sh fills this from claude-helper/.token
LLM_HELPER_TOKEN=
# Model the helper runs; start the helper with the same value. Part of the reply cache key
CLAUDE_MODEL=sonnet
# Max successful (uncached) Claude calls per process
LLM_MAX_CALLS=50
